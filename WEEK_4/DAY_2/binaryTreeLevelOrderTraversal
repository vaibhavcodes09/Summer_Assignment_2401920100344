class Solution {
    public List<List<Integer>> levelOrder(TreeNode root) {
        List<List<Integer>> sol = new ArrayList<>();
        Deque<TreeNode> dq = new ArrayDeque<>();
        if(root==null ) return sol;
        dq.add(root);
        while(!dq.isEmpty()){
            int len = dq.size();
            List<Integer> lvl = new ArrayList<>();
            for(int i =0; i<len;i++){
                TreeNode curr = dq.poll();
                lvl.add(curr.val);
                if(curr.left!=null)
                dq.add(curr.left);
                if(curr.right!=null)
                dq.add(curr.right);
            }
            sol.add(lvl);
        }
        return sol;
    }
}