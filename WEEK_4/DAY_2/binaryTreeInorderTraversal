class Solution {
    public List<Integer> inorderTraversal(TreeNode root) {
        List<Integer> res = new ArrayList<Integer>();
        Stack<TreeNode> st = new Stack<TreeNode>();
        TreeNode node = root;

        while(node!=null||!st.empty()){
            if(node!=null){
                st.push(node);
                node = node.left;
            }
            else{
                node = st.pop();
                res.add(node.val);
                node = node.right;
            }
        }
        return res;
    }
}