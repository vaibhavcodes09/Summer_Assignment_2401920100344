class Solution {
    public int diagonalSum(int[][] mat) {
        int diagSum =0;
        int m = mat.length;
        for( int i =0; i<m;i++){
            diagSum+=mat[i][i];

        int j = m-(i+1);
        if(i!=j){
            diagSum+= mat[i][j];
        }
        }
        return diagSum;
    }
}