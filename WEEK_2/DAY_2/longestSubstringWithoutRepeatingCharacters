class Solution {
    public int lengthOfLongestSubstring(String s) {
        int [] charIdx = new int[128];
        int start =0; 
        int maxLen =0;
        for(int end =0;end<s.length();end++){
            char ch = s.charAt(end);
        if(charIdx[ch]>0){
            start = Math.max(charIdx[ch],start);
        }
        maxLen = Math.max(maxLen,end-start+1);
        charIdx[ch]= end+1;
       
    }
    return maxLen;
    }
}