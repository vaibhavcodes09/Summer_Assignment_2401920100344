class Solution {
    private int front =0;
    private int maxLength=0;
    public String longestPalindrome(String s) {
        
        for( int i =0; i<s.length();i++){
            longerPalindrome(s,i,i);
            longerPalindrome(s,i,i+1);
        }
        return s.substring(front,front+maxLength);
    }
    public void longerPalindrome(String s , int start , int end ){
        while(start>=0&&end<s.length()&&s.charAt(start)==s.charAt(end)){
        
                start--;
                end++;
        }
        int length = end - start -1;
        if(length>maxLength){
            maxLength = length;
            front = start+1;
        }
    }
}