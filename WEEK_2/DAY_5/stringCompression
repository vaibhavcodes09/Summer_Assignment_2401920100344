class Solution {
    public int compress(char[] chars) {
        int idx =0;
        for(int i =0; i<chars.length;i++){
            char ch = chars[i];
            int freq =0;
            while(i<chars.length&&chars[i]== ch){
                freq++;
                i++;
            }
            if(freq==1){
                chars[idx] = ch;
                idx++;
            }
            else{
                chars [idx] = ch;
                idx++;
                for(char digit :Integer.toString(freq).toCharArray()){
                    chars[idx] = digit;
                    idx++;
                }
            }
            i--;
        }
        return idx;
    }
}