lass Solution {
    public int firstUniqChar(String s) {
       int [] freq = new int[26];
       for(char ch :s.toCharArray()){
        freq[ch-'a']++;
       }
       int idx =0;
       while(idx<s.length()){
        if(freq[s.charAt(idx)-'a']>1){
            idx++;
        }
        else if(freq[s.charAt(idx)-'a']==1){
            return idx;
        }
       }
       return -1;
    }
}