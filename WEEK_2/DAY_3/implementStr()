class Solution {
    public int strStr(String haystack, String needle) {
       int h = haystack.length();
       int n = needle.length();
       int idx =0;
       while(idx<=h-n){
        if(haystack.substring(idx,idx+n).equals(needle)){
        return idx;
        }
        idx++;
       }
       return -1;
    }
}