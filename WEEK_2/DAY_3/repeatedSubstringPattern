lass Solution {
    public boolean repeatedSubstringPattern(String s) {
        int len = s.length();
        for( int i = len/2;i>=1;i--){
            if(len%i==0){
                int freq = len/i;
                String sub = s.substring(0,i);
                StringBuilder newStr = new StringBuilder();
                for(int j =0; j<freq;j++){
                    newStr.append(sub);
                }
                if(s.contains(newStr.toString()))
                return true;
            }
        }
        return false;
    }
}